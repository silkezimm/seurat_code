                               cluster_rows=FALSE,
                               width=1600, height=1200, res=200,
                               cex_col=0.7, cex_row=0.55,
                               scale_label="Centered log1p (gene-centered)") {
  mat_center <- as.matrix(mat_center)
  if (nrow(mat_center) < 2 || ncol(mat_center) < 2) return(invisible(NULL))
  
  if (cluster_rows && nrow(mat_center) > 1) {
    ord <- stats::hclust(stats::dist(mat_center))$order
    mat_center <- mat_center[ord, , drop=FALSE]
  }
  
  cols <- colorRampPalette(c("blue","grey90","red"))(101)
  zlim <- range(mat_center, finite=TRUE)
  if (!is.finite(zlim[1]) || !is.finite(zlim[2]) || zlim[1] == zlim[2]) {
    zlim <- c(-1, 1)
  }
  
  png(file, width=width, height=height, res=res)
  layout(matrix(c(1,2), nrow=1), widths=c(4.5, 1.0))
  par(mar=c(6,10,3,2))
  
  # heatmap with explicit x/y to avoid dimension mismatches
  z <- t(mat_center[nrow(mat_center):1, , drop=FALSE])   # ncol x nrow
  image(x = seq_len(ncol(mat_center)),
        y = seq_len(nrow(mat_center)),
        z = z,
        col = cols, zlim = zlim, axes = FALSE,
        main = main_title, xlab = "", ylab = "")
  
  axis(1, at=seq_len(ncol(mat_center)), labels=col_labels, las=2, cex.axis=cex_col)
  axis(2, at=seq_len(nrow(mat_center)), labels=rev(rownames(mat_center)), las=2, cex.axis=cex_row)
  
  # scale bar (panel 2)
  par(mar=c(6,2,3,4))
  yseq <- seq(zlim[1], zlim[2], length.out=101)
  zbar <- matrix(yseq, nrow=1)
  image(x=c(0,1), y=yseq, z=zbar, col=cols, axes=FALSE, xlab="", ylab="")
  axis(4, las=1, cex.axis=0.8)
  mtext(scale_label, side=4, line=2.2, cex=0.9)
  
  dev.off()
  layout(1)
}

