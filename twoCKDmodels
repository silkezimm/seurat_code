is_mt_gene <- function(g) grepl("^mt-", g, ignore.case = FALSE)

read_one_10x <- function(sample_name, data_dir,
                         model_label = c("CKD1","CKD2"),
                         condition_label = c("CTRL","CKD"),
                         min.cells = 3, min.features = 200) {
  
  model_label <- match.arg(model_label)
  condition_label <- match.arg(condition_label)
  
  counts <- Read10X(data.dir = data_dir)
  
  obj <- CreateSeuratObject(
    counts = counts,
    assay = "RNA",
    project = sample_name,
    min.cells = min.cells,
    min.features = min.features
  )
  
  obj$sample    <- sample_name
  obj$model     <- model_label
  obj$condition <- condition_label
  obj$batch     <- sample_name  # IMPORTANT: batch = sample (technical), NOT model
  
  return(obj)
}

