  output_dir <- getwd()
}

celltype_col  <- "celltype6"
model_col     <- "model"
condition_col <- "condition"

meta_df <- seurat_obj@meta.data %>%
  dplyr::select(
    celltype  = all_of(celltype_col),
    model     = all_of(model_col),
    condition = all_of(condition_col)
  )

cell_counts_long <- meta_df %>%
  dplyr::count(model, condition, celltype, name = "n_cells") %>%
  dplyr::arrange(model, condition, celltype)

cell_counts_wide <- cell_counts_long %>%
  tidyr::unite(group, model, condition, sep = "_") %>%
  tidyr::pivot_wider(
    names_from  = group,
    values_from = n_cells,
    values_fill = 0
  )

