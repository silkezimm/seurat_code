# Pseudobulk (SUM raw counts per sample or sample+meta)
make_pseudobulk <- function(seu_obj, group_vars = c("sample","model","condition","celltype6"),
                            assay="RNA", layer="counts") {
  DefaultAssay(seu_obj) <- assay
  seu_obj[[assay]] <- JoinLayers(seu_obj[[assay]])
  
  counts <- GetAssayData(seu_obj, layer = layer)  # genes x cells
  meta   <- as.data.frame(seu_obj@meta.data)
  
  stopifnot(all(group_vars %in% colnames(meta)))
  meta$.grp <- apply(meta[, group_vars, drop=FALSE], 1, paste, collapse="__")
  groups <- unique(meta$.grp)
  
  pb <- sapply(groups, function(g) {
    cells <- rownames(meta)[meta$.grp == g]
    Matrix::rowSums(counts[, cells, drop=FALSE])
  })
  pb <- as.matrix(pb)
  colnames(pb) <- groups
  
  pb_meta <- meta %>%
    dplyr::select(all_of(group_vars), .grp) %>%
    distinct(.grp, .keep_all=TRUE) %>%
    as.data.frame()
  rownames(pb_meta) <- pb_meta$.grp
  
  list(counts = pb, meta = pb_meta)
}

run_edger <- function(pb_counts, pb_meta, contrast_var,
                      ident_1, ident_2,
                      min_libsize = 2000) {
  
  # filter low-depth pseudobulk columns
  lib <- colSums(pb_counts)
  keep <- lib >= min_libsize
  pb_counts <- pb_counts[, keep, drop=FALSE]
  pb_meta   <- pb_meta[colnames(pb_counts), , drop=FALSE]
  
  if (ncol(pb_counts) < 2) return(NULL)
  if (!all(c(ident_1, ident_2) %in% unique(pb_meta[[contrast_var]]))) return(NULL)
  
  pb_meta[[contrast_var]] <- factor(pb_meta[[contrast_var]], levels = c(ident_2, ident_1))
  design <- model.matrix(~ pb_meta[[contrast_var]])
  
  y <- DGEList(counts = pb_counts)
  y <- calcNormFactors(y)
  y <- estimateDisp(y, design)
  fit <- glmQLFit(y, design)
  qlf <- glmQLFTest(fit, coef = 2)
  
  tt <- topTags(qlf, n=Inf)$table
  tt$gene <- rownames(tt)
  rownames(tt) <- NULL
  
  # exclude mt genes from outputs (snRNA hygiene)
  tt <- tt[!is_mt_gene(tt$gene), , drop=FALSE]
  tt
}

write_xlsx_one <- function(df, file, sheet="Sheet1") {
  # Excel outputs should be robust (no broken columns / easy to read)
  wb <- createWorkbook()
  addWorksheet(wb, sheet)
  
  writeDataTable(
    wb, sheet, df,
    withFilter = TRUE,
    tableStyle = "TableStyleMedium9"
  )
  
  # header formatting + usability
  headerStyle <- createStyle(textDecoration = "bold")
  addStyle(wb, sheet, style = headerStyle, rows = 1, cols = 1:ncol(df), gridExpand = TRUE)
  freezePane(wb, sheet, firstRow = TRUE)
  setColWidths(wb, sheet, cols = 1:ncol(df), widths = "auto")
  
  saveWorkbook(wb, file, overwrite = TRUE)
}

